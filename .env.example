# Copy to .env and fill in real values.
# Never commit .env.

# Bind address for published ports (security default: localhost only)
# Use 0.0.0.0 only behind a trusted private network / firewall.
BIND_ADDRESS=127.0.0.1

# Host port mappings (container ports stay the same)
# Change these if the host port is already allocated.
UPTIME_KUMA_PORT=3002
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
CADVISOR_PORT=8080
NODE_EXPORTER_PORT=9100

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-strong-password
GF_SERVER_ROOT_URL=http://127.0.0.1:3000

# Alertmanager → Telegram (metrics / host / container alerts)
# Create a bot via @BotFather and get chat id via @userinfobot or getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email (leave empty to disable in alertmanager.yml)
SMTP_HOST=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# Uptime Kuma (UI on host port UPTIME_KUMA_PORT, container still listens on 3001)
# Availability alerts should use Kuma's own Telegram notifier — do not duplicate
# the same checks in Alertmanager.
