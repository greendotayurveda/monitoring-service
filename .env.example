# Copy to .env and fill in real values.
# Never commit .env.

# Bind address for published ports
# - 127.0.0.1 = localhost only (needs SSH tunnel from another machine)
# - 0.0.0.0   = reachable via LAN / Tailscale IP (same pattern as Jellyfin/qBittorrent)
# Prefer Tailscale + host firewall over exposing these ports on a public WAN IP.
BIND_ADDRESS=0.0.0.0

# Host port mappings (only services that publish ports)
GRAFANA_PORT=3010
UPTIME_KUMA_PORT=3002
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-strong-password
GF_SERVER_ROOT_URL=http://127.0.0.1:3010

# Alertmanager → Telegram (metrics / host / container alerts)
# Create a bot via @BotFather and get chat id via @userinfobot or getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional email (leave empty to disable)
SMTP_HOST=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# Uptime Kuma UI on host port UPTIME_KUMA_PORT (container still listens on 3001)
# Availability alerts should use Kuma's own Telegram notifier — do not duplicate
# the same checks in Alertmanager.
